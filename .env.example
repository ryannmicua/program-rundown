# Host-local configuration; replace placeholders. No credentials belong in git.
APP_ENV=dev
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://app.example.invalid
OIDC_ISSUER=https://issuer.example.invalid
OIDC_CLIENT_ID=replace-with-client-id
# Public OIDC client with token_endpoint_auth_method=none and PKCE.
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
DEV_COORDINATOR_ISSUER=https://issuer.example.invalid
DEV_COORDINATOR_SUBJECT=replace-with-synthetic-subject
FEEDBACK_ENABLED=false
PRODUCT_DB_PATH=/data/program-rundown.sqlite
FEEDBACK_DB_PATH=/feedback-data/feedback.sqlite
